            "url": "{{baseUrl}}/pedidos",
            "description": "Todo pedido nuevo debe empezar en estado recibido. Esperado: 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"producto_id\": 2,\n  \"cantidad\": 5,\n  \"centro_distribucion\": \"Bogotá\",\n  \"estado\": \"entregado\"\n}",
              "options": {
