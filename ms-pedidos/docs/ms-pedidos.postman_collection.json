  "item": [
    {
      "name": "Taller 2 · Semana 1 · CRUD (casos 1 a 13)",
      "description": "Pruebas de la Semana 1 para ms-pedidos. El caso 3 (?ids=) no aplica a ms-pedidos porque este servicio no es uno de los recursos consultados por lotes. No requiere JWT.",
      "item": [
        {
          "name": "1. Listar todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pedidos",
            "description": "Esperado: 200 con un arreglo."
          }
        },
        {
          "name": "2. Filtrar por estado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Todos cumplen el filtro', () => pm.response.json().forEach(r => pm.expect(r.estado).to.eql('recibido')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pedidos?estado=recibido",
            "description": "Filtro por atributo. Esperado: 200, todos con estado = recibido."
          }
        },
        {
          "name": "4. Obtener un registro existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el 1', () => pm.expect(pm.response.json().id).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pedidos/1",
            "description": "Esperado: 200."
          }
        },
        {
          "name": "5. Obtener un id que no existe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 404', () => pm.response.to.have.status(404));",
                  "pm.test('Trae mensaje de error', () => pm.expect(pm.response.json()).to.have.property('error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pedidos/99999",
            "description": "Esperado: 404."
          }
        },
        {
          "name": "6. Obtener con id no numérico",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400', () => pm.response.to.have.status(400));",
                  "pm.test('Trae mensaje de error', () => pm.expect(pm.response.json()).to.have.property('error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pedidos/abc",
            "description": "Esperado: 400."
          }
        },
        {
          "name": "7. Crear con datos válidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', () => pm.response.to.have.status(201));",
                  "pm.test('Cabecera Location', () => pm.response.to.have.header('Location'));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('idCreado', pm.response.json().id);",
                  "pm.test('Queda en estado recibido', () => pm.expect(pm.response.json().estado).to.eql('recibido'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pedidos",
            "description": "Esperado: 201 + cabecera Location. Guarda el id en idCreado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"producto_id\": 2,\n  \"cantidad\": 50,\n  \"centro_distribucion\": \"Cali\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "8. Crear sin un atributo obligatorio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400', () => pm.response.to.have.status(400));",
                  "pm.test('Lista detalles', () => pm.expect(pm.response.json().detalles).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pedidos",
            "description": "Falta producto_id, cantidad 0 y centro inválido. Esperado: 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 1,\n  \"cantidad\": 0,\n  \"centro_distribucion\": \"Medellín\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
