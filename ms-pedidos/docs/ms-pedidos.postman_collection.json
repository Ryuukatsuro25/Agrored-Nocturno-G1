            ],
            "url": "{{baseUrl}}/pedidos/{{idCreado}}",
            "description": "PUT reemplaza el registro completo. Esperado: 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": 2,\n  \"producto_id\": 1,\n  \"cantidad\": 60,\n  \"centro_distribucion\": \"Bogotá\",\n  \"estado\": \"despachado\",\n  \"fecha\": \"2026-11-03\"\n}",
