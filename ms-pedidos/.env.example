# Copie este archivo como .env y ajuste los valores. El .env NO se sube al repositorio.
PORT=3004
HOST=127.0.0.1
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pedidos_db
DB_USER=pedidos_user
DB_PASSWORD=escriba-aqui-la-clave
# La misma frase secreta en todos los microservicios del grupo (se comparte por un medio privado)
JWT_SECRET=escriba-aqui-la-frase-del-grupo
# Dónde escuchan los microservicios que ms-pedidos consulta
CLIENTES_URL=http://127.0.0.1:3003
PRODUCTOS_URL=http://127.0.0.1:3002
