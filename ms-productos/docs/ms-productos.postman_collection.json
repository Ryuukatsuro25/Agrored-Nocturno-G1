  "item": [
    {
      "name": "0 · Iniciar sesión (ejecutar primero)",
      "description": "Requiere ms-usuarios corriendo en el puerto 3001. Guarda los tokens de administrador, comercial y produccion en variables de la colección.",
      "item": [
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('token_admin', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios/login",
            "description": "Inicia sesión como administrador y guarda el token en la variable token_admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_admin}}\",\n  \"password\": \"{{password_admin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Crear usuario comercial (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201 o 409', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/usuarios",
            "description": "El administrador crea el usuario de prueba de este rol. 201 la primera vez; 409 si ya existe. Ambos sirven.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Comercial de Prueba\",\n  \"email\": \"{{email_comercial}}\",\n  \"rol\": \"comercial\",\n  \"password\": \"{{password_prueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            }
          }
        },
