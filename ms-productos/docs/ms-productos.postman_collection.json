      "description": "Casos de la Parte 2 del taller.",
      "item": [
        {
          "name": "1. Listar todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos",
            "description": "Esperado: 200 con un arreglo."
          }
        },
        {
          "name": "2. Filtrar por categoria",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Todos cumplen el filtro', () => pm.response.json().forEach(r => pm.expect(r.categoria).to.eql('fruta')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos?categoria=fruta",
            "description": "Filtro por atributo. Esperado: 200, todos con categoria = fruta."
          }
        },
