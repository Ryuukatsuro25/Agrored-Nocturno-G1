{
  "info": {
    "_postman_id": "b01d1421-fe69-4a10-88fb-858934109350",
    "name": "ms-productos",
    "description": "Taller 2 · semana 1 · ms-productos (AgroRed S.A.S.). Pruebas del CRUD completo, filtros, códigos de estado y persistencia MySQL. En esta etapa las rutas no requieren autenticación JWT. Ejecute los casos 1 a 13 en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "idCreado",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · CRUD completo · Taller 2 semana 1 (casos 1 a 13)",
      "description": "Ejecute en orden. No requiere Bearer Token ni ms-usuarios.",
      "item": [
        {
          "name": "1. Listar todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos",
            "description": "Esperado: 200 con un arreglo."
          }
        },
        {
          "name": "2. Filtrar por categoria",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Todos cumplen el filtro', () => pm.response.json().forEach(r => pm.expect(r.categoria).to.eql('fruta')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos?categoria=fruta",
            "description": "Filtro por atributo. Esperado: 200, todos con categoria = fruta."
          }
        },
        {
          "name": "3. Consultar por lotes ?ids=1,2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Trae solo los ids pedidos', () => pm.expect(pm.response.json().map(r => r.id)).to.eql([1, 2]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos?ids=1,2",
            "description": "Lo usa ms-pedidos para componer. Esperado: 200 con exactamente los registros 1 y 2."
          }
        },
        {
          "name": "4. Obtener un registro existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el 1', () => pm.expect(pm.response.json().id).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos/1",
            "description": "Esperado: 200."
          }
        },
        {
          "name": "5. Obtener un id que no existe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 404', () => pm.response.to.have.status(404));",
                  "pm.test('Trae mensaje de error', () => pm.expect(pm.response.json()).to.have.property('error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos/99999",
            "description": "Esperado: 404."
          }
        },
        {
          "name": "6. Obtener con id no numérico",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400', () => pm.response.to.have.status(400));",
                  "pm.test('Trae mensaje de error', () => pm.expect(pm.response.json()).to.have.property('error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos/abc",
            "description": "Esperado: 400."
          }
        },
        {
          "name": "7. Crear con datos válidos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('nombre_nuevo', 'Aguacate Hass ' + Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', () => pm.response.to.have.status(201));",
                  "pm.test('Cabecera Location', () => pm.response.to.have.header('Location'));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('idCreado', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/productos",
            "description": "Esperado: 201 + cabecera Location. Guarda el id en idCreado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombre_nuevo}}\",\n  \"categoria\": \"fruta\",\n  \"unidad\": \"kg\",\n  \"precio\": 9800\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "8. Crear sin un atributo obligatorio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400', () => pm.response.to.have.status(400));",
                  "pm.test('Lista detalles', () => pm.expect(pm.response.json().detalles).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/productos",
            "description": "Faltan unidad y precio. Esperado: 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Aguacate Hass\",\n  \"categoria\": \"fruta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "9. Crear violando la regla: nombre repetido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 409', () => pm.response.to.have.status(409));",
                  "pm.test('Trae mensaje de error', () => pm.expect(pm.response.json()).to.have.property('error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/productos",
            "description": "Mango Tommy ya existe (sin distinguir mayúsculas). Esperado: 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"mango tommy\",\n  \"categoria\": \"fruta\",\n  \"unidad\": \"kg\",\n  \"precio\": 7000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "10. Actualizar un registro existente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('nombre_editado', 'Aguacate procesado ' + Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Se actualizó categoria', () => pm.expect(pm.response.json().categoria).to.eql('procesado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/productos/{{idCreado}}",
            "description": "PUT reemplaza el registro completo. Esperado: 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombre_editado}}\",\n  \"categoria\": \"procesado\",\n  \"unidad\": \"caja\",\n  \"precio\": 52000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "11. Actualizar un id que no existe",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('nombre_editado', 'Aguacate procesado ' + Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/productos/99999",
            "description": "Esperado: 404.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombre_editado}}\",\n  \"categoria\": \"procesado\",\n  \"unidad\": \"caja\",\n  \"precio\": 52000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "12. Eliminar un registro existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/productos/{{idCreado}}",
            "description": "Esperado: 204 sin cuerpo."
          }
        },
        {
          "name": "13. Eliminar el mismo registro otra vez",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/productos/{{idCreado}}",
            "description": "Ya no existe. Esperado: 404."
          }
        }
      ]
    }
