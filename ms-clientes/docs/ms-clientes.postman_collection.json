            "url": "{{baseUrl}}/clientes/99999",
            "description": "Esperado: 404.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Frutas del Pacífico S.A.S.\",\n  \"nit\": \"{{nit_creado}}\",\n  \"ciudad\": \"Cali\",\n  \"telefono\": \"6024445566\",\n  \"tipo\": \"comercio\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "12. Eliminar un registro existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/clientes/{{idCreado}}",
            "description": "Esperado: 204 sin cuerpo."
          }
        },
        {
          "name": "13. Eliminar el mismo registro otra vez",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 404', () => pm.response.to.have.status(404));"
