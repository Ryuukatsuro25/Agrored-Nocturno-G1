    "name": "ms-clientes",
    "description": "Taller 2 · semana 1 · ms-clientes (AgroRed S.A.S.). Pruebas del CRUD completo, filtros, códigos de estado y persistencia MySQL. En esta etapa las rutas no requieren autenticación JWT. Ejecute los casos 1 a 13 en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3003"
    },
    {
      "key": "idCreado",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · CRUD completo · Taller 2 semana 1 (casos 1 a 13)",
      "description": "Ejecute en orden. No requiere Bearer Token ni ms-usuarios.",
      "item": [
        {
          "name": "1. Listar todos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes",
            "description": "Esperado: 200 con un arreglo."
          }
        },
        {
          "name": "2. Filtrar por tipo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Todos cumplen el filtro', () => pm.response.json().forEach(r => pm.expect(r.tipo).to.eql('comercio')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes?tipo=comercio",
            "description": "Filtro por atributo. Esperado: 200, todos con tipo = comercio."
          }
        },
        {
          "name": "3. Consultar por lotes ?ids=1,2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Trae solo los ids pedidos', () => pm.expect(pm.response.json().map(r => r.id)).to.eql([1, 2]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes?ids=1,2",
            "description": "Lo usa ms-pedidos para componer. Esperado: 200 con exactamente los registros 1 y 2."
          }
        },
        {
          "name": "4. Obtener un registro existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el 1', () => pm.expect(pm.response.json().id).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes/1",
            "description": "Esperado: 200."
          }
        },
        {
          "name": "5. Obtener un id que no existe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 404', () => pm.response.to.have.status(404));",
                  "pm.test('Trae mensaje de error', () => pm.expect(pm.response.json()).to.have.property('error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes/99999",
            "description": "Esperado: 404."
          }
        },
        {
          "name": "6. Obtener con id no numérico",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400', () => pm.response.to.have.status(400));",
                  "pm.test('Trae mensaje de error', () => pm.expect(pm.response.json()).to.have.property('error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clientes/abc",
            "description": "Esperado: 400."
          }
        },
        {
          "name": "7. Crear con datos válidos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('nit_nuevo', String(900000000 + Math.floor(Math.random() * 99999999)) + '-' + Math.floor(Math.random() * 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', () => pm.response.to.have.status(201));",
                  "pm.test('Cabecera Location', () => pm.response.to.have.header('Location'));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('idCreado', pm.response.json().id);",
                  "if (pm.response.code === 201) pm.collectionVariables.set('nit_creado', pm.response.json().nit);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clientes",
            "description": "Esperado: 201 + cabecera Location. Guarda el id en idCreado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Frutas del Pacífico\",\n  \"nit\": \"{{nit_nuevo}}\",\n  \"ciudad\": \"Buenaventura\",\n  \"telefono\": \"3154442211\",\n  \"tipo\": \"distribuidor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "8. Crear sin un atributo obligatorio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 400', () => pm.response.to.have.status(400));",
                  "pm.test('Lista detalles', () => pm.expect(pm.response.json().detalles).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clientes",
            "description": "Faltan nit y telefono. Esperado: 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sin NIT\",\n  \"ciudad\": \"Cali\",\n  \"tipo\": \"comercio\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "9. Crear violando la regla: NIT repetido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 409', () => pm.response.to.have.status(409));",
                  "pm.test('Trae mensaje de error', () => pm.expect(pm.response.json()).to.have.property('error'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clientes",
            "description": "El NIT 900123456-7 ya es de Distribuidora El Valle. Esperado: 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Repetido S.A.S.\",\n  \"nit\": \"900123456-7\",\n  \"ciudad\": \"Cali\",\n  \"telefono\": \"6020000000\",\n  \"tipo\": \"comercio\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "10. Actualizar un registro existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Se actualizó tipo', () => pm.expect(pm.response.json().tipo).to.eql('comercio'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clientes/{{idCreado}}",
            "description": "PUT reemplaza el registro completo. Esperado: 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Frutas del Pacífico S.A.S.\",\n  \"nit\": \"{{nit_creado}}\",\n  \"ciudad\": \"Cali\",\n  \"telefono\": \"6024445566\",\n  \"tipo\": \"comercio\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
